{
  "$comment": "Personal Scheduling design tokens. Platform-neutral; map to CSS vars (web) or a SwiftUI Color/Font extension (native). Colors are hex; each account has a light+dark pair.",
  "color": {
    "neutral": {
      "light": {
        "bgCanvas": "#F5F5F7",
        "surface": "#FFFFFF",
        "surfaceSunken": "#F0F0F3",
        "text1": "#1D1D1F",
        "text2": "#6E6E73",
        "text3": "#A1A1A6",
        "hairline": "rgba(0,0,0,0.07)"
      },
      "dark": {
        "bgCanvas": "#000000",
        "surface": "#1C1C1E",
        "surfaceElevated": "#2C2C2E",
        "text1": "#F5F5F7",
        "text2": "#98989D",
        "text3": "#6E6E73",
        "hairline": "rgba(255,255,255,0.08)"
      }
    },
    "accountPalette": [
      { "id": "acct-1", "light": "#0071E3", "dark": "#0A84FF" },
      { "id": "acct-2", "light": "#5E5CE6", "dark": "#5E5CE6" },
      { "id": "acct-3", "light": "#FF2D92", "dark": "#FF375F" },
      { "id": "acct-4", "light": "#FF9500", "dark": "#FF9F0A" },
      { "id": "acct-5", "light": "#AF52DE", "dark": "#BF5AF2" },
      { "id": "acct-6", "light": "#30B0C7", "dark": "#40C8E0" }
    ],
    "$accountNote": "Not a fixed account list — any connected account is assigned one of the 6 palette slots deterministically by hashing its email (src/lib/design/accounts.ts), so color stays stable per-account without hardcoding which accounts exist. Account display name defaults to the email; user can rename it.",
    "semantic": {
      "free":      { "light": "#34C759", "dark": "#30D158" },
      "busy":      { "light": "#8E8E93", "dark": "#8E8E93" },
      "confirmed": { "light": "#0071E3", "dark": "#0A84FF" },
      "cancelled": { "light": "#FF3B30", "dark": "#FF453A" },
      "warning":   { "light": "#FF9500", "dark": "#FF9F0A" }
    }
  },
  "typography": {
    "family": "system SF stack: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, monospace",
    "scale": {
      "display":  { "size": 34, "lineHeight": 40, "weight": 700, "tracking": "-0.025em" },
      "title1":   { "size": 28, "lineHeight": 34, "weight": 600, "tracking": "-0.02em" },
      "title2":   { "size": 22, "lineHeight": 28, "weight": 600, "tracking": "-0.015em" },
      "title3":   { "size": 17, "lineHeight": 22, "weight": 600 },
      "body":     { "size": 15, "lineHeight": 22, "weight": 400 },
      "callout":  { "size": 14, "lineHeight": 20, "weight": 400 },
      "footnote": { "size": 13, "lineHeight": 18, "weight": 400 },
      "caption":  { "size": 12, "lineHeight": 16, "weight": 400 },
      "numeric":  { "$note": "any size + font-variant-numeric: tabular-nums; used for all times/dates" }
    }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48] },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "elevation": {
    "e1": "0 1px 2px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.05)",
    "e2Light": "0 4px 12px rgba(0,0,0,.10)",
    "e2Dark":  "0 4px 12px rgba(0,0,0,.40)",
    "e3Light": "0 12px 40px rgba(0,0,0,.16)",
    "e3Dark":  "0 18px 50px rgba(0,0,0,.55)"
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": { "standard": "cubic-bezier(.2,0,0,1)", "emphasized": "cubic-bezier(.32,.72,0,1)" }
  }
}
