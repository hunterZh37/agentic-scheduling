{
  "flow": "private",
  "note": "Owner-facing dashboard agent (runPrivateAgent), full tool set. Owner tz America/New_York. The private prompt requires confirming a mutation before calling the tool, so most cases include the confirm exchange and grade the tool SELECTION at commit; dash-09 grades confirm-first discipline directly. Fixtures are canned; no real writes.",
  "cases": [
    {
      "id": "dash-01-event-not-block",
      "tags": ["tool-choice", "event"],
      "frozenNow": "2026-09-08T14:00:00Z",
      "messages": [
        { "role": "user", "content": "Schedule lunch with Sam this Friday from 12 to 1." },
        { "role": "assistant", "content": "Sure, lunch with Sam this Friday, 12:00 to 1:00 PM Eastern. Want me to add it?" },
        { "role": "user", "content": "Yes, add it." }
      ],
      "fixtures": { "create_event": { "ok": true, "id": "evt_test" } },
      "expect": {
        "mustCall": [ { "name": "create_event", "args": {}, "contains": ["2026-09-11"] } ],
        "mustNotCall": ["create_personal_block", "create_actionable"]
      }
    },
    {
      "id": "dash-02-block-not-event",
      "tags": ["tool-choice", "block"],
      "frozenNow": "2026-09-08T14:00:00Z",
      "messages": [
        { "role": "user", "content": "Block off 6 to 8 every morning for the gym so nobody can book me then." },
        { "role": "assistant", "content": "Got it, I'll reserve 6:00 to 8:00 AM every morning for the gym. Add it?" },
        { "role": "user", "content": "Yes." }
      ],
      "fixtures": { "create_personal_block": { "ok": true, "id": "blk_test" } },
      "expect": {
        "mustCall": [ { "name": "create_personal_block", "args": {} } ],
        "mustNotCall": ["create_event"]
      }
    },
    {
