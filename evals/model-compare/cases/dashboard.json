      "fixtures": {
        "get_schedule": { "events": [ { "id": "evt_sync_9", "providerId": "prov_sync_9", "title": "Design sync", "start": "2026-09-08T19:00:00Z", "end": "2026-09-08T19:30:00Z", "accountEmail": "hunter@example.com", "kind": "event" } ] },
