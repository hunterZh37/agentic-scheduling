# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template's example file must be tracked so others can set up.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e
/test-results/
/playwright-report/
/playwright/.cache/
docs/media/demo-1270.gif

# Local agent tooling (skills installed via `npx skills add`, Claude Code) — never commit to the public repo
/.agents/
/.claude/
/skills-lock.json
