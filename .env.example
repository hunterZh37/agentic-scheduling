# ---------------------------------------------------------------------------
# Agentic Scheduling — environment configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Database (local dev via docker compose) -------------------------------
DATABASE_URL="postgresql://scheduling:scheduling@localhost:5433/scheduling?schema=public"
# Direct (unpooled) connection used by `prisma migrate deploy`. On serverless
# (Neon/Supabase) DATABASE_URL is the pooled PgBouncer endpoint and this is the
# direct one. Locally, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://scheduling:scheduling@localhost:5433/scheduling?schema=public"

# --- App -------------------------------------------------------------------
# Base URL of the deployed app (used for OAuth redirects, booking links).
APP_BASE_URL="http://localhost:3000"
# Attendee-facing base URL (public booking domain) used in links emailed to
# bookers, e.g. the self-serve manage/reschedule link. Defaults to
# http://localhost:3000 if unset.
PUBLIC_BASE_URL="http://localhost:3000"
# Secret protecting the private interface / private agent (single-user auth).
PRIVATE_AUTH_SECRET=""

# --- Owner identity (public booking page + agent prompts + notifications) --
# Full name, shown on the public booking page and in email signatures.
# Also read as NEXT_PUBLIC_OWNER_NAME because it's needed by the
# client-rendered booking page — Next.js only inlines NEXT_PUBLIC_* vars into
# the browser bundle, so this MUST use that prefix, not a plain OWNER_NAME.
NEXT_PUBLIC_OWNER_NAME="Alex Rivera"
# Optional public LinkedIn profile, appended to the booking invite's
# signature. Leave blank to omit it. Same NEXT_PUBLIC_ requirement as above.
NEXT_PUBLIC_OWNER_LINKEDIN=""
# Optional fixed video-call room included on every booking (event location +
# invite), e.g. a reusable Google Meet/Zoom link. Leave blank to omit it.
NEXT_PUBLIC_OWNER_VIDEO_LINK=""
# Where new bookings are written by default, and the fallback destination for
# the owner's own reminders/alerts. (Legacy alias: HUNTER_EMAIL, still
# honored.)
OWNER_EMAIL="owner@example.com"
DEFAULT_DESTINATION_EMAIL="owner@example.com"
# The owner's phone/WhatsApp number, used for SMS control (see below) and
# booking/reminder alerts. (Legacy aliases: HUNTER_SMS_NUMBER,
# HUNTER_WHATSAPP_NUMBER — still honored.)
OWNER_SMS_NUMBER=""
OWNER_WHATSAPP_NUMBER=""
# The owner's home timezone. Personal blocks, the agent's sense of "today",
# and the 7am morning-brief guard are all anchored to this. (Legacy alias:
# HUNTER_TIMEZONE, still honored.)
OWNER_TIMEZONE="America/New_York"
# Client-side copy of the timezone, inlined at BUILD time (used by the agent
# prompt and the morning-brief 7am DST guard via src/lib/clientConfig.ts). Keep
# it equal to OWNER_TIMEZONE. Changing it in prod requires a redeploy, not just
# an env edit, because NEXT_PUBLIC_* vars are baked into the build. (Legacy
# alias: NEXT_PUBLIC_HUNTER_TIMEZONE, still honored.)
NEXT_PUBLIC_OWNER_TIMEZONE="America/New_York"

# --- Google Calendar API ---------------------------------------------------
# Per-account OAuth client, used for every connected Google account that
# isn't using domain-wide delegation (see below).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
# Domain-wide delegation service account (for accounts on a Google Workspace
# domain you administer). JSON key, base64-encoded to keep it single-line.
GOOGLE_DELEGATION_SA_KEY_B64=""

# --- Microsoft Graph (Outlook account) -------------------------------------
MS_OAUTH_CLIENT_ID=""
MS_OAUTH_CLIENT_SECRET=""
MS_OAUTH_TENANT_ID="common"
MS_OAUTH_REDIRECT_URI="http://localhost:3000/api/oauth/microsoft/callback"

# --- Claude API (both agents) ----------------------------------------------
ANTHROPIC_API_KEY=""

# --- Speech-to-text (inbound WhatsApp voice notes) -------------------------
# OpenAI Whisper transcribes voice notes so the agent can act on them.
# Get a key at https://platform.openai.com/api-keys. Leave blank to disable.
OPENAI_API_KEY=""

# --- Reminders -------------------------------------------------------------
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="reminders@example.com"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Two-way SMS control channel (inbound webhook at /api/sms/inbound). Only
# OWNER_SMS_NUMBER may control the agent. Set to "true" to bypass Twilio
# signature validation for LOCAL dev only — never in production.
SMS_SKIP_SIGNATURE_CHECK=""
# Web push (VAPID) — bonus channel.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"

# --- Cron worker auth ------------------------------------------------------
# Shared secret Vercel Cron sends so the reminder route rejects public calls.
CRON_SECRET=""

# --- Daily WhatsApp morning brief ------------------------------------------
# A 7am (OWNER_TIMEZONE) WhatsApp message summarizing the day, sent by the
# hourly /api/cron/morning-brief cron. WhatsApp blocks business-initiated
# messages unless they use a pre-approved template, so this uses Twilio's
# Content API: create + get a WhatsApp template approved, then set its SID here.
# The generated one-line brief is passed as template variable {{1}}.
TWILIO_MORNING_BRIEF_CONTENT_SID=""
# Optional: approved WhatsApp template SID for the "new booking" alert the
# owner gets when a visitor books. If set, the alert delivers any time
# (variable {{1}} is the booking summary). If UNSET, the alert falls back to a
# freeform WhatsApp message, which only lands within 24h of the owner last
# messaging the sandbox.
TWILIO_BOOKING_ALERT_CONTENT_SID=""
# The WhatsApp-enabled Twilio sender, e.g. "whatsapp:+14155238886".
TWILIO_WHATSAPP_FROM=""
